# Copy to frontend/.env.local. Only VITE_* variables reach the browser,
# so never put secrets in them.

# Base URL of the Django API as seen by the browser. Keep the default "/api"
# in development (Vite proxies it) and when the API is served on the same
# domain in production. Use a full URL only for a cross-origin API, which
# also needs CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS on the backend.
VITE_API_BASE_URL=/api

# Development only (not sent to the browser): where Vite forwards /api and /media.
API_PROXY_TARGET=http://127.0.0.1:8000
