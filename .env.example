# Copy to .env and fill in real values. Never commit .env.
# Required (the app refuses to start without them):
#   DJANGO_SECRET_KEY, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
# With DEBUG off it also refuses a short or placeholder secret key and an
# empty DJANGO_ALLOWED_HOSTS.

# ---- Django
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Off unless set. Use True only for local development (runserver + Vite).
DJANGO_DEBUG=False
# Host names the site answers to, e.g. market.example.co.ke
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Django Admin path. Not "admin/": that path is the React staff area.
DJANGO_ADMIN_URL=django-admin/
# Sign-in session length in seconds (default 12 hours)
SESSION_COOKIE_AGE=43200

# ---- HTTPS and proxies (apply when DJANGO_DEBUG=False)
# Keep all of these on for any public deployment.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
# Start low on a new domain (e.g. 300), raise to 31536000 once HTTPS is proven.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
# True only when a TLS-terminating proxy in front sets X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
# Reverse proxies in front of Django when running it directly (runserver: 0).
DJANGO_NUM_PROXIES=0
# The same for the Docker stack: 1 for its nginx, plus 1 for each proxy in
# front of it (e.g. 2 behind a TLS terminator or load balancer).
# STACK_NUM_PROXIES=1

# ---- PostgreSQL
POSTGRES_DB=mkulima
POSTGRES_USER=mkulima
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Or one URL instead of the POSTGRES_* values (Render sets this from render.yaml):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Browser origins (only needed if the API is served from a different
# origin than the site; the default setups are same-origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Cache: shared rate-limit counters. Leave unset for one dev server;
# the Docker stack sets redis://redis:6379/0 itself.
# CACHE_URL=redis://localhost:6379/0

# ---- Uploaded media
# "local": files on disk under MEDIA_ROOT (nginx serves them in Docker).
# "s3": any S3-compatible store (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
MEDIA_STORAGE=local
# MEDIA_ROOT=/var/lib/mkulima/media
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=          # omit for AWS; e.g. https://<account>.r2.cloudflarestorage.com
# S3_REGION_NAME=
# S3_ADDRESSING_STYLE=      # "path" for MinIO and most self-hosted stores
# S3_CUSTOM_DOMAIN=         # CDN or public bucket domain, e.g. media.example.co.ke
# S3_SIGNED_URLS=False      # True for a private bucket (time-limited links)
# S3_LOCATION=media
# With S3, allow the media origin in the site's Content-Security-Policy:
# CSP_IMG_SRC='self' data: https://media.example.co.ke

# ---- Rate limits (DRF format: number/second|minute|hour|day)
THROTTLE_ANON=600/minute
THROTTLE_USER=240/minute
THROTTLE_INQUIRIES=10/hour
THROTTLE_FINANCIAL=10/hour
THROTTLE_LOGIN=30/hour
THROTTLE_LOGIN_ACCOUNT=10/hour
THROTTLE_REGISTER=10/hour

# ---- Docker stack
# WEB_PORT=8080
# GUNICORN_WORKERS=3

# ---- Payment provider (e.g. M-Pesa Daraja): NOT integrated.
# Settings will be added here, as placeholders, only when the integration is
# built with real credentials.
